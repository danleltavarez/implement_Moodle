# TODO: Copie este arquivo para .env e substitua as senhas pelos seus valores reais
# cp docker/.env.example docker/.env

# =============================================================================
# Configuração do banco de dados PostgreSQL (serviço "db" no compose local)
# =============================================================================

# Nome do banco de dados criado no PostgreSQL
POSTGRES_DB=moodle

# Usuário do banco de dados PostgreSQL
POSTGRES_USER=moodle

# Senha do banco de dados PostgreSQL — substitua por uma senha forte
POSTGRES_PASSWORD=changeme_strong_password

# =============================================================================
# Configuração do entrypoint (instalador CLI do Moodle)
# Usadas por docker-compose.yml (local) e docker-compose.aws.yml (AWS)
# =============================================================================

# Tipo de driver de banco para o Moodle (pgsql = PostgreSQL nativo)
MOODLE_DB_TYPE=pgsql

# Host do banco de dados
# Local: nome do serviço Docker ("db")
# AWS:   endpoint do RDS (preenchido automaticamente pelo user_data.sh)
MOODLE_DB_HOST=db

# Porta do banco de dados
MOODLE_DB_PORT=5432

# Nome do banco de dados
MOODLE_DB_NAME=moodle

# Usuário do banco de dados
MOODLE_DB_USER=moodle

# Senha do banco de dados — deve coincidir com POSTGRES_PASSWORD acima
# TODO: Substitua por uma senha forte antes de usar em produção
MOODLE_DB_PASSWORD=changeme_strong_password

# Prefixo das tabelas do Moodle no banco de dados
MOODLE_DB_PREFIX=mdl_

# URL base do Moodle (wwwroot)
# Local: http://localhost:8080
# AWS:   preenchido automaticamente pelo user_data.sh com o DNS público da EC2
# TODO: Na AWS, substitua pelo DNS público da EC2 antes de subir o container
MOODLE_WWWROOT=http://localhost:8080

# Usuário administrador do Moodle
MOODLE_ADMIN_USER=admin

# Senha do administrador — substitua por uma senha forte
# TODO: Use uma senha forte. Requisitos Moodle: mínimo 8 chars, maiúscula, número e símbolo
MOODLE_ADMIN_PASSWORD=Admin1234!

# E-mail do administrador
MOODLE_ADMIN_EMAIL=admin@example.com

# Nome exibido no site Moodle
MOODLE_SITE_NAME=Moodle Challenge
